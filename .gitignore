# rebuilds from the raw data, and local run state.
outputs/**/cache/
outputs/**/checkpoints/
outputs/alerts/pred_*.npz
outputs/alerts/watch.npz
outputs/**/*.log
outputs/**/live.json
outputs/jobs/
outputs/pipeline/
